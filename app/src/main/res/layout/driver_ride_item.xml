<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F1F1F1">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FF5252"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/imgStartDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/circle_background"
            app:tint="#4CAF50"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvFromLocation"
            app:layout_constraintBottom_toBottomOf="@id/tvFromLocation" />

        <View
            android:id="@+id/lineRoute"
            android:layout_width="1.5dp"
            android:layout_height="20dp"
            android:background="#EEEEEE"
            app:layout_constraintTop_toBottomOf="@id/imgStartDot"
            app:layout_constraintBottom_toTopOf="@id/imgEndDot"
            app:layout_constraintStart_toStartOf="@id/imgStartDot"
            app:layout_constraintEnd_toEndOf="@id/imgStartDot" />

        <ImageView
            android:id="@+id/imgEndDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/circle_background"
            app:tint="#F44336"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvToLocation"
            app:layout_constraintBottom_toBottomOf="@id/tvToLocation" />

        <TextView
            android:id="@+id/tvFromLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nawabshah"
            android:textSize="15sp"
            android:fontFamily="@font/my_fontbold"
            android:textColor="#1A1C1E"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toEndOf="@id/imgStartDot"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDelete" />

        <TextView
            android:id="@+id/tvToLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hyderabad"
            android:textSize="15sp"
            android:fontFamily="@font/my_fontbold"
            android:textColor="#1A1C1E"
            android:layout_marginTop="16dp"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toEndOf="@id/imgEndDot"
            app:layout_constraintTop_toBottomOf="@id/tvFromLocation"
            app:layout_constraintEnd_toEndOf="@id/tvFromLocation" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F8F8F8"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvToLocation" />

        <LinearLayout
            android:id="@+id/bottomInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Today, 4:00 PM"
                android:textSize="12sp"
                android:textColor="#757575"
                android:fontFamily="@font/my_font" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600 PKR"
                android:textSize="15sp"
                android:textColor="@color/primary"
                android:fontFamily="@font/my_fontbold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewPayments"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="View Payment Requests (2)"
            android:textColor="#E65100"
            android:backgroundTint="#FFF3E0"
            android:textAllCaps="false"
            app:layout_constraintTop_toBottomOf="@id/bottomInfo"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvSeatsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seats Confirmed: 1/4"
            android:textSize="11sp"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/btnViewPayments"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>