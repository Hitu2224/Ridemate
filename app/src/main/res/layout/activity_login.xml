<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F0"
    android:padding="24dp"
    tools:context=".AuthActivities.LoginActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1" />

    <LinearLayout
        android:id="@+id/llPhoneInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@id/guidelineTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/my_fontbold"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="Enter your phone number to\nstart"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCountry"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:background="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="18dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/icon_pakistan"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/my_font"
                        android:text="+92"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Phone number"
                app:boxBackgroundMode="none"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/my_font"
                    android:inputType="phone"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llOtpInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/guidelineTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/my_fontbold"
            android:text="Verification Code"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/my_font"
            android:text="We have sent the code verification to\nyour mobile number"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:weightSum="6">

            <EditText android:id="@+id/otpDigit1" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/otp_background" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="18sp" tools:ignore="LabelFor" />
            <EditText android:id="@+id/otpDigit2" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_marginStart="3dp" android:background="@drawable/otp_background" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="18sp" tools:ignore="LabelFor" />
            <EditText android:id="@+id/otpDigit3" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_marginStart="3dp" android:background="@drawable/otp_background" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="18sp" tools:ignore="LabelFor" />
            <EditText android:id="@+id/otpDigit4" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_marginStart="3dp" android:background="@drawable/otp_background" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="18sp" tools:ignore="LabelFor" />
            <EditText android:id="@+id/otpDigit5" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_marginStart="3dp" android:background="@drawable/otp_background" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="18sp" tools:ignore="LabelFor" />
            <EditText android:id="@+id/otpDigit6" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="3dp" android:background="@drawable/otp_background" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="18sp" tools:ignore="LabelFor" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMainAction"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Request code"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="@font/my_fontbold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>