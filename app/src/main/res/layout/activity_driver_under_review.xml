<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="24dp">

    <!-- Center Content Wrapper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/btnLogout"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Hourglass / Clock Icon for Pending State -->
        <ImageView
            android:id="@+id/imgClock"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="@color/primary"
            android:layout_marginBottom="24dp" />

        <!-- Main Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile Under Review"
            android:textColor="#0F172A"
            android:textSize="24sp"
            android:fontFamily="@font/my_fontbold"
            android:textStyle="bold"
            />

        <!-- Description Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Thank you for submitting your documents! Our admin team is verifying your details. It usually takes 1-2 hours to activate your account."
            android:textColor="#475569"
            android:textSize="15sp"
            android:fontFamily="@font/my_font"
            android:gravity="center"
            android:lineSpacingExtra="4sp"/>

    </LinearLayout>

    <!-- Logout Button at the Bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Log Out"
        android:textColor="#EF4444"
        android:fontFamily="@font/my_fontbold"
        app:strokeColor="#EF4444"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>